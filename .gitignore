# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.eggs/
build/
dist/

# Large calibration / data assets — these "follow" to the observing machine and are
# never committed. They must be present at their package-relative paths at deploy.
*.fits
*.pkl
llamas_ql/mastercalib/*
!llamas_ql/mastercalib/.gitkeep
llamas_ql/LUT/LLAMAS_reference_arc.pkl

# Pipeline outputs / logs
llamas_ql/output/
output/
logs/
*.log

# OS / editor
.DS_Store
